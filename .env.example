# Contact form email (Resend). Copy to .env.local for local testing, and add
# the same variables in Vercel > Project > Settings > Environment Variables.

# Required for the form to send. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. The sender, on a domain you have verified in Resend.
# Until nuit.works is verified, leave this empty: Resend's test sender is used,
# which can only deliver to the email address on your Resend account.
CONTACT_FROM_EMAIL="Nuit Works website <website@nuit.works>"

# Optional. Where enquiries are delivered. Defaults to hello@nuit.works.
CONTACT_TO_EMAIL=hello@nuit.works
