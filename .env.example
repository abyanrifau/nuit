# Environment variables for the Nuit Works site.
# Copy this file to .env.local for local testing (never commit .env.local),
# and add the same variables in Vercel > Project > Settings > Environment
# Variables for Production (and Preview if you want previews to send too).

# Contact form (Resend) ------------------------------------------------------

# Required for the contact form to send email. Create one at
# https://resend.com/api-keys (permission: "Sending access").
# Without it, the form shows "Your message didn't go through." and offers a
# prefilled email to hello@nuit.works instead.
RESEND_API_KEY=

# Optional. The sender address. Defaults to forms@nuit.works, which only
# works once the nuit.works domain is verified in Resend (Domains page).
CONTACT_FROM_EMAIL="Nuit Works website <forms@nuit.works>"

# Optional. Where enquiries are delivered. Defaults to hello@nuit.works.
# Replies go straight to the visitor (their address is set as reply-to).
CONTACT_TO_EMAIL=hello@nuit.works

# Set automatically, do not add ----------------------------------------------
# VERCEL      Set by Vercel on its builds; turns on Vercel Web Analytics.
# NODE_ENV    Set by Next.js; "production" adds the Content-Security-Policy.
